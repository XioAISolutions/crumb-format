    "handoff",
    "context",
    "memory",
    "compaction",
    "session",
    "interop",
    "portability"
  ],
  "commands": "./integrations/claude-code/commands",
  "mcpServers": "./.claude-plugin/mcp.json",
  "hooks": "./.claude-plugin/hooks.json"
