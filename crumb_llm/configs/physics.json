{
  "arch": "wave_field",
  "tokenizer": "byte",
  "dim": 256,
  "n_layers": 6,
  "n_heads": 8,
  "field_size": 1024,
  "block_size": 1024,
  "ffn_mult": 2.667,
  "causal": true,
  "kernel_mode": "freq",
  "dropout": 0.1,
  "tie_embeddings": true,
  "boundary": "absorbing",
  "dispersion": true,
  "interference_mixer": true,
  "batch_size": 32,
  "lr": 0.0006,
  "weight_decay": 0.1,
  "warmup": 500
}
