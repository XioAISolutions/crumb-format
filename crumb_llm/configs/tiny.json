{
  "arch": "wave_field",
  "tokenizer": "char",
  "dim": 96,
  "n_layers": 3,
  "n_heads": 4,
  "field_size": 128,
  "block_size": 128,
  "ffn_mult": 2.0,
  "causal": true,
  "kernel_mode": "freq",
  "dropout": 0.0,
  "tie_embeddings": true,
  "batch_size": 16,
  "lr": 0.001,
  "weight_decay": 0.05,
  "warmup": 50
}
