# Wave Field LLM - Kubernetes Secrets Template
# This file contains templates for Kubernetes secrets
# DO NOT commit actual secrets to version control

---
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: production
type: Opaque
stringData:
  host: postgres.example.com
  port: "5432"
  database: wavefield_production
  username: wavefield_user
  password: <CHANGE_ME>  # Use strong password
  connection-string: postgresql://wavefield_user:<CHANGE_ME>@postgres.example.com:5432/wavefield_production

---
apiVersion: v1
kind: Secret
metadata:
  name: redis-credentials
  namespace: production
type: Opaque
stringData:
  host: redis.example.com
  port: "6379"
  password: <CHANGE_ME>  # Use strong password
  connection-string: redis://:<CHANGE_ME>@redis.example.com:6379/0

---
apiVersion: v1
kind: Secret
metadata:
  name: aws-credentials
  namespace: production
type: Opaque
stringData:
  access-key-id: <CHANGE_ME>
  secret-access-key: <CHANGE_ME>
  region: us-east-1
  ecr-registry: 123456789012.dkr.ecr.us-east-1.amazonaws.com

---
apiVersion: v1
kind: Secret
metadata:
  name: gcp-credentials
  namespace: production
type: Opaque
stringData:
  project-id: wavefield-production
  service-account-key: |
    {
      "type": "service_account",
      "project_id": "wavefield-production",
      "private_key_id": "<CHANGE_ME>",
      "private_key": "<CHANGE_ME>",
      "client_email": "wavefield@wavefield-production.iam.gserviceaccount.com",
      "client_id": "<CHANGE_ME>",
      "auth_uri": "https://accounts.google.com/o/oauth2/auth",
      "token_uri": "https://oauth2.googleapis.com/token",
      "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
      "client_x509_cert_url": "<CHANGE_ME>"
    }

---
apiVersion: v1
kind: Secret
metadata:
  name: azure-credentials
  namespace: production
type: Opaque
stringData:
  subscription-id: <CHANGE_ME>
  tenant-id: <CHANGE_ME>
  client-id: <CHANGE_ME>
  client-secret: <CHANGE_ME>
  resource-group: wavefield-production
  storage-account: wavefieldprod

---
apiVersion: v1
kind: Secret
metadata:
  name: api-keys
  namespace: production
type: Opaque
stringData:
  admin-api-key: <CHANGE_ME>  # Generate with: openssl rand -hex 32
  service-api-key: <CHANGE_ME>  # Generate with: openssl rand -hex 32
  monitoring-api-key: <CHANGE_ME>  # Generate with: openssl rand -hex 32

---
apiVersion: v1
kind: Secret
metadata:
  name: tls-certificates
  namespace: production
type: kubernetes.io/tls
data:
  tls.crt: <BASE64_ENCODED_CERTIFICATE>
  tls.key: <BASE64_ENCODED_PRIVATE_KEY>
  ca.crt: <BASE64_ENCODED_CA_CERTIFICATE>

---
apiVersion: v1
kind: Secret
metadata:
  name: model-registry-credentials
  namespace: production
type: Opaque
stringData:
  registry-url: https://models.wavefield-llm.example.com
  username: wavefield
  password: <CHANGE_ME>
  api-token: <CHANGE_ME>

---
apiVersion: v1
kind: Secret
metadata:
  name: monitoring-credentials
  namespace: production
type: Opaque
stringData:
  grafana-admin-password: <CHANGE_ME>
  prometheus-admin-password: <CHANGE_ME>
  alertmanager-webhook-url: <CHANGE_ME>

---
apiVersion: v1
kind: Secret
metadata:
  name: alerting-credentials
  namespace: production
type: Opaque
stringData:
  slack-webhook-url: <CHANGE_ME>
  pagerduty-integration-key: <CHANGE_ME>
  email-smtp-host: smtp.example.com
  email-smtp-port: "587"
  email-smtp-username: alerts@example.com
  email-smtp-password: <CHANGE_ME>

---
apiVersion: v1
kind: Secret
metadata:
  name: backup-credentials
  namespace: production
type: Opaque
stringData:
  s3-bucket: wavefield-backups-production
  s3-access-key: <CHANGE_ME>
  s3-secret-key: <CHANGE_ME>
  encryption-key: <CHANGE_ME>  # Generate with: openssl rand -base64 32

---
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secrets
  namespace: production
type: Opaque
stringData:
  jwt-secret-key: <CHANGE_ME>  # Generate with: openssl rand -hex 64
  jwt-algorithm: HS256
  jwt-expiration: "3600"

---
# Docker registry secret for pulling private images
apiVersion: v1
kind: Secret
metadata:
  name: docker-registry-credentials
  namespace: production
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: <BASE64_ENCODED_DOCKER_CONFIG>
  # Generate with:
  # kubectl create secret docker-registry docker-registry-credentials \
  #   --docker-server=<registry-url> \
  #   --docker-username=<username> \
  #   --docker-password=<password> \
  #   --docker-email=<email> \
  #   --dry-run=client -o yaml | grep '.dockerconfigjson:' | awk '{print $2}'

---
# Instructions for creating secrets:
#
# 1. Copy this file and replace all <CHANGE_ME> placeholders with actual values
# 2. For base64 encoding: echo -n "value" | base64
# 3. Apply secrets: kubectl apply -f secrets.yaml
# 4. Verify: kubectl get secrets -n production
# 5. Delete this template file after creating actual secrets
#
# Security best practices:
# - Use strong, randomly generated passwords
# - Rotate secrets regularly
# - Use external secret management (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Enable encryption at rest for secrets
# - Limit access using RBAC
# - Never commit actual secrets to version control
# - Use sealed-secrets or external-secrets operator for GitOps