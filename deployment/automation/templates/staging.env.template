# Wave Field LLM - Staging Environment Configuration
# Copy this file to staging.env and fill in the values

# Environment
ENVIRONMENT=staging
DEPLOYMENT_NAME=wavefield-llm-staging

# Application Configuration
APP_NAME=wavefield-llm
APP_VERSION=latest
LOG_LEVEL=DEBUG
DEBUG_MODE=true

# Model Configuration
MODEL_NAME=wavefield-small
MODEL_VERSION=1.0.0
MODEL_PATH=/models
MAX_SEQUENCE_LENGTH=2048
BATCH_SIZE=8
NUM_WORKERS=4

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
TIMEOUT=300
KEEPALIVE=65

# Database Configuration
DB_HOST=postgres-staging.example.com
DB_PORT=5432
DB_NAME=wavefield_staging
DB_USER=wavefield_user
DB_PASSWORD=<CHANGE_ME>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SSL_MODE=require

# Redis Configuration
REDIS_HOST=redis-staging.example.com
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME>
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SSL=true

# Object Storage Configuration (S3/GCS/Azure Blob)
STORAGE_TYPE=s3  # s3, gcs, or azure
STORAGE_BUCKET=wavefield-models-staging
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=<CHANGE_ME>
STORAGE_SECRET_KEY=<CHANGE_ME>

# AWS Configuration (if using AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<CHANGE_ME>
AWS_SECRET_ACCESS_KEY=<CHANGE_ME>
AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# GCP Configuration (if using GCP)
GCP_PROJECT_ID=wavefield-staging
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_KEY=<BASE64_ENCODED_KEY>

# Azure Configuration (if using Azure)
AZURE_SUBSCRIPTION_ID=<CHANGE_ME>
AZURE_RESOURCE_GROUP=wavefield-staging
AZURE_LOCATION=eastus
AZURE_STORAGE_ACCOUNT=wavefieldstaging

# Kubernetes Configuration
KUBE_NAMESPACE=staging
KUBE_CONTEXT=staging-cluster
REPLICAS=2
MIN_REPLICAS=1
MAX_REPLICAS=5

# Resource Limits
CPU_REQUEST=1000m
CPU_LIMIT=2000m
MEMORY_REQUEST=4Gi
MEMORY_LIMIT=8Gi
GPU_REQUEST=0
GPU_LIMIT=1

# Monitoring Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
JAEGER_ENABLED=true
JAEGER_ENDPOINT=http://jaeger-collector:14268/api/traces

# Logging Configuration
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOKI_ENABLED=true
LOKI_URL=http://loki:3100

# Security Configuration
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/tls.crt
TLS_KEY_PATH=/etc/ssl/certs/tls.key
CORS_ENABLED=true
CORS_ORIGINS=https://staging.wavefield-llm.example.com
API_KEY_REQUIRED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# Feature Flags
ENABLE_STREAMING=true
ENABLE_BATCH_INFERENCE=true
ENABLE_QUANTIZATION=true
ENABLE_CACHING=true
ENABLE_METRICS=true
ENABLE_TRACING=true

# Performance Tuning
CACHE_TTL=3600
CACHE_MAX_SIZE=10000
CONNECTION_POOL_SIZE=100
REQUEST_TIMEOUT=120
INFERENCE_TIMEOUT=60

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE_PATH=s3://wavefield-backups-staging/

# Alerting Configuration
ALERT_EMAIL=alerts-staging@example.com
ALERT_SLACK_WEBHOOK=<CHANGE_ME>
ALERT_PAGERDUTY_KEY=<CHANGE_ME>

# Health Check Configuration
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
READINESS_CHECK_PATH=/ready

# Autoscaling Configuration
HPA_ENABLED=true
HPA_CPU_THRESHOLD=70
HPA_MEMORY_THRESHOLD=80
HPA_SCALE_UP_STABILIZATION=60
HPA_SCALE_DOWN_STABILIZATION=300

# Network Configuration
INGRESS_CLASS=nginx
INGRESS_HOST=staging.wavefield-llm.example.com
LOAD_BALANCER_TYPE=nlb
SERVICE_TYPE=LoadBalancer

# Development Tools
ENABLE_SWAGGER=true
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_PROFILING=true